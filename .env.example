# ── Required ─────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
TOKEN=YOUR_BOT_TOKEN_HERE

# Your bot's Client ID (Application ID) from the Developer Portal
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Guild ID for fast (guild-scoped) slash command registration during development
# Leave empty to register commands globally (takes up to 1 hour to propagate)
DEV_GUILD_ID=

# ── Optional ─────────────────────────────────────────────
# Log channel ID where moderation actions are posted
LOG_CHANNEL_ID=


# Owner / admin user IDs (comma separated) — full access
OWNER_IDS=

# Default role ID assigned to new members by the welcome system
MEMBER_ROLE_ID=

# Default warn limit before a user is auto-muted (0 to disable)
WARN_AUTOMUTE_LIMIT=3

# ── Database (optional, for warnings/leveling persistence) ──
# If left empty, an in-memory store is used (resets on restart)
DATABASE_URL=
